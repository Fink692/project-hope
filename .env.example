DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-this-in-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8090
DJANGO_TRUST_PROXY=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0
DATABASE_URL=postgresql://hope:hope@localhost:5432/hope
# Optional development/test isolation only; production requires DATABASE_URL.
PROJECT_HOPE_SQLITE_PATH=
VALKEY_URL=redis://localhost:6379/0
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/project-hope
KEYCLOAK_CLIENT_ID=project-hope-web
KEYCLOAK_CLIENT_SECRET=
DEMO_ADMIN_PASSWORD=change-me-now
AI_GATEWAY_ENV=development
AI_GATEWAY_URL=http://localhost:9000
AI_GATEWAY_TOKEN=
AI_GATEWAY_TIMEOUT_SECONDS=3
AI_PROVIDER=ollama
AI_OLLAMA_URL=http://localhost:11434
AI_OLLAMA_CHAT_MODEL=qwen3:4b
AI_OLLAMA_EMBED_MODEL=all-minilm
AI_OLLAMA_TIMEOUT_SECONDS=45
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_STARTTLS=false
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10
SMTP_FROM=Project Hope <noreply@example.org>
PROJECT_HOPE_PUBLIC_URL=http://localhost:5173
PROJECT_HOPE_PILOT_VERIFICATION_MAX_AGE_SECONDS=604800
PROJECT_HOPE_PILOT_EMAIL_RETRY_SECONDS=900
PROJECT_HOPE_PILOT_EMAIL_RETRY_BATCH_SIZE=20
PROJECT_HOPE_INVITATION_MAX_AGE_SECONDS=604800
PROJECT_HOPE_INVITATION_EMAIL_RETRY_SECONDS=900
PROJECT_HOPE_INVITATION_EMAIL_RETRY_BATCH_SIZE=20
PASSWORD_RESET_TIMEOUT=3600
PROJECT_HOPE_API_TOKEN_MAX_AGE_SECONDS=2592000
PROJECT_HOPE_MFA_REQUIRED=false
PROJECT_HOPE_MFA_ISSUER=Project Hope
# Comma-separated Fernet keys, newest first. Required in production; never commit a real key.
PROJECT_HOPE_MFA_ENCRYPTION_KEYS=
PROJECT_HOPE_MFA_LOGIN_CHALLENGE_MAX_AGE_SECONDS=300
PROJECT_HOPE_MFA_ENROLLMENT_MAX_AGE_SECONDS=600
PROJECT_HOPE_MFA_TOTP_VALID_WINDOW=1
PROJECT_HOPE_MFA_RECOVERY_CODE_COUNT=10
PROJECT_HOPE_PASSWORD_RESET_QUEUE_MAX_AGE_SECONDS=900
PROJECT_HOPE_PASSWORD_RESET_EMAIL_RETRY_SECONDS=120
PROJECT_HOPE_PASSWORD_RESET_EMAIL_RETRY_BATCH_SIZE=20
PROJECT_HOPE_PASSWORD_RESET_DELIVERY_RETENTION_DAYS=7
PROJECT_HOPE_PILOT_UNVERIFIED_RETENTION_DAYS=14
PROJECT_HOPE_PILOT_DECLINED_RETENTION_DAYS=90
PROJECT_HOPE_PILOT_INACTIVE_RETENTION_DAYS=365
PROJECT_HOPE_PILOT_CLEANUP_INTERVAL=86400
DRF_PILOT_APPLICATION_RATE=10/hour
DRF_PILOT_VERIFICATION_RATE=30/hour
DRF_INVITATION_PUBLIC_RATE=30/hour
DRF_PASSWORD_RESET_REQUEST_RATE=5/hour
DRF_PASSWORD_RESET_TOKEN_RATE=30/hour
DRF_AUTH_LOGIN_ACCOUNT_RATE=10/minute
DRF_AUTH_LOGIN_IP_RATE=60/minute
DRF_AUTH_MFA_CHALLENGE_RATE=10/minute
DRF_AUTH_MFA_ENROLLMENT_RATE=10/hour
# Direct development has no trusted proxy. Production Compose defaults to Caddy=1.
DRF_NUM_PROXIES=0
PROJECT_HOPE_MAX_DOCUMENT_BYTES=26214400
PROJECT_HOPE_MAX_UNCOMPRESSED_DOCUMENT_BYTES=104857600
PROJECT_HOPE_MAX_DOCUMENT_ARCHIVE_MEMBERS=1000
PROJECT_HOPE_MAX_CRM_IMPORT_BYTES=5242880
PROJECT_HOPE_MAX_CRM_IMPORT_ROWS=2500
PROJECT_HOPE_CRM_IMPORT_PREVIEW_MAX_AGE_SECONDS=900
