{
  "name": "project-hope-desktop",
  "version": "1.9.1",
  "private": true,
  "description": "A complete sample charity workspace, with optional connection to your hosted team",
  "author": {
    "name": "Project Hope",
    "email": "fink692@users.noreply.github.com"
  },
  "homepage": "https://project-hope-charities.vercel.app",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/write-default-config.mjs",
    "build:bundle": "pnpm --dir ../web build && node scripts/build-runtime.mjs && pnpm build",
    "test": "pnpm build && node --test tests/*.test.cjs",
    "test:runtime": "node scripts/smoke-runtime.mjs",
    "start": "pnpm build && electron .",
    "dist": "pnpm build:bundle && electron-builder --publish never",
    "dist:win": "pnpm build:bundle && electron-builder --win nsis --publish never",
    "dist:mac": "pnpm build:bundle && electron-builder --mac dmg zip --publish never",
    "dist:linux": "pnpm build:bundle && electron-builder --linux AppImage deb --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@types/node": "24.2.0",
    "electron": "37.2.6",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "org.projecthope.desktop",
    "productName": "Project Hope",
    "artifactName": "Project-Hope-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "beforePack": "scripts/verify-bundle.cjs",
    "extraResources": [
      { "from": "resources/runtime", "to": "runtime" },
      { "from": "resources/web", "to": "web" }
    ],
    "publish": {
      "provider": "generic",
      "url": "https://project-hope-charities.vercel.app/downloads/"
    },
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Project Hope",
      "runAfterFinish": true
    },
    "mac": {
      "icon": "icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Fink692 <fink692@users.noreply.github.com>"
    }
  }
}
