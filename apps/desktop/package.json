{
  "name": "project-hope-desktop",
  "version": "1.8.0",
  "private": true,
  "description": "The Project Hope desktop application for hosted charity workspaces",
  "author": {
    "name": "Project Hope",
    "email": "fink692@users.noreply.github.com"
  },
  "homepage": "https://github.com/Fink692/project-hope",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/write-default-config.mjs",
    "start": "pnpm build && electron .",
    "dist": "pnpm build && electron-builder --publish never",
    "dist:win": "pnpm build && electron-builder --win nsis --publish never",
    "dist:mac": "pnpm build && electron-builder --mac dmg zip --publish never",
    "dist:linux": "pnpm build && electron-builder --linux AppImage deb --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@types/node": "24.2.0",
    "electron": "37.2.6",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "org.projecthope.desktop",
    "productName": "Project Hope",
    "artifactName": "Project-Hope-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "Fink692",
      "repo": "project-hope",
      "releaseType": "release"
    },
    "win": {
      "icon": "icon.svg",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Project Hope",
      "runAfterFinish": true
    },
    "mac": {
      "icon": "icon.svg",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "icon.svg",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Fink692 <fink692@users.noreply.github.com>"
    }
  }
}
